diff --git a/src/modules/admin/catalogFilter.test.ts b/src/modules/admin/catalogFilter.test.ts
new file mode 100644
index 0000000..4532053
--- /dev/null
+++ b/src/modules/admin/catalogFilter.test.ts
@@ -0,0 +1,44 @@
+import { describe, it, expect } from 'vitest'
+import { filterCatalog } from './catalogFilter'
+
+const cats = [
+  { id: 1, name: 'Мебель' },
+  { id: 2, name: 'Посуда' },
+]
+const items = [
+  { name: 'Стул', category_id: 1 },
+  { name: 'Стол', category_id: 1 },
+  { name: 'Тарелка', category_id: 2 },
+]
+// «перевод»: английское название ищется как подстрока
+const match = (q: string, base: string, kind: 'item' | 'category') => {
+  const en: Record<string, string> = { 'Мебель': 'Furniture', 'Стул': 'Chair', 'Тарелка': 'Plate' }
+  void kind
+  return `${base} ${en[base] ?? ''}`.toLowerCase().includes(q.toLowerCase())
+}
+
+describe('filterCatalog', () => {
+  it('empty query keeps every category with all its items', () => {
+    const r = filterCatalog(cats, items, '  ', match)
+    expect(r.map((g) => g.items.length)).toEqual([2, 1])
+    expect(r.every((g) => !g.matched)).toBe(true)
+  })
+
+  it('a category hit shows all its items, other categories are hidden', () => {
+    const r = filterCatalog(cats, items, 'furniture', match)
+    expect(r).toHaveLength(1)
+    expect(r[0].category.id).toBe(1)
+    expect(r[0].items).toHaveLength(2)
+    expect(r[0].matched).toBe(true)
+  })
+
+  it('an item hit shows only matching items of its category', () => {
+    const r = filterCatalog(cats, items, 'chair', match)
+    expect(r).toHaveLength(1)
+    expect(r[0].items.map((i) => i.name)).toEqual(['Стул'])
+  })
+
+  it('no matches gives an empty list', () => {
+    expect(filterCatalog(cats, items, 'zzz', match)).toEqual([])
+  })
+})
diff --git a/src/modules/admin/catalogFilter.ts b/src/modules/admin/catalogFilter.ts
new file mode 100644
index 0000000..bd8bbef
--- /dev/null
+++ b/src/modules/admin/catalogFilter.ts
@@ -0,0 +1,39 @@
+export interface CatalogGroup<C, I> {
+  category: C
+  items: I[]
+  /** true, если категория попала в выдачу из-за поискового запроса */
+  matched: boolean
+}
+
+type Matcher = (query: string, base: string, kind: 'item' | 'category') => boolean
+
+/**
+ * Поиск по каталогу: если совпала категория, показываются все её предметы,
+ * иначе только совпавшие предметы; категории без совпадений скрываются.
+ */
+export function filterCatalog<C extends { id: number; name: string }, I extends { name: string; category_id: number }>(
+  categories: C[],
+  items: I[],
+  query: string,
+  match: Matcher,
+): CatalogGroup<C, I>[] {
+  const q = query.trim()
+  const byCat = new Map<number, I[]>()
+  for (const it of items) {
+    const list = byCat.get(it.category_id) ?? []
+    list.push(it)
+    byCat.set(it.category_id, list)
+  }
+  const out: CatalogGroup<C, I>[] = []
+  for (const category of categories) {
+    const all = byCat.get(category.id) ?? []
+    if (!q) {
+      out.push({ category, items: all, matched: false })
+      continue
+    }
+    const categoryHit = match(q, category.name, 'category')
+    const hits = categoryHit ? all : all.filter((it) => match(q, it.name, 'item'))
+    if (categoryHit || hits.length > 0) out.push({ category, items: hits, matched: true })
+  }
+  return out
+}
